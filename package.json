{
  "name": "beautymall-next",
  "version": "1.0.0",
  "private": true,
  "description": "BeautyMall — parapharmacie (Next.js), reconstruite depuis le clone beautymall.ma",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3002",
    "import:clone": "node scripts/import-clone.mjs",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.mjs",
    "setup": "prisma db push && node prisma/seed.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "15.5.27",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "cheerio": "1.0.0",
    "prisma": "^6.19.3",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
