# PostgreSQL (Prisma Postgres / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Vercel Blob: admin uploads go to Blob when set (added automatically when you connect a Blob store).
# Leave empty locally to save uploads in storage/uploads.
BLOB_READ_WRITE_TOKEN=""

AUTH_SECRET="change-me-to-a-long-random-string"
SITE_URL="https://www.example.com"
ADMIN_EMAIL="admin@beautymall.ma"
ADMIN_PASSWORD="admin123"
